{
  "expo": {
    "name": "Pulse Pocket",
    "slug": "pulse-pocket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pulsepocket",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nathanoyewole.pulsepocket"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.nathanoyewole.pulsepocket"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#00ff9d"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "78b9c701-60af-40e7-b89c-46233ba3efb9"
      }
    }
  }
}

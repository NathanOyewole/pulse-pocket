{
  "expo": {
    "name": "Pulse Pocket",
    "slug": "pulse-pocket",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "pulsepocket",
    "userInterfaceStyle": "dark",
    "splash": {
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.nathanoyewole.pulsepocket"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#000000"
      },
      "package": "com.nathanoyewole.pulsepocket"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "color": "#00ff9d"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}

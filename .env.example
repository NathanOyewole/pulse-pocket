# Copy this to .env and fill in real values. Never commit .env itself.

EXPO_PUBLIC_OPENROUTER_API_KEY=
EXPO_PUBLIC_HELIUS_API_KEY=
EXPO_PUBLIC_BIRDEYE_API_KEY=
# Free at https://portal.jup.ag/ - api.jup.ag now requires this even on
# the free tier since lite-api.jup.ag (the old keyless host) is being
# phased out. App still runs without it via the lite-api fallback while
# that lasts, but get one for reliability.
EXPO_PUBLIC_JUPITER_API_KEY=
